<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JWT Practice</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h1>Login Account</h1>
        <form method="post" action="/login">
            <input class="py-3 px-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none" type="email" placeholder="Email" name="email">
            <input class="py-3 px-2 rounded-md bg-transparent border-2 border-zinc-800 outline-none" type="password" placeholder="Password" name="password">
            <input class="py-2 px-5 rounded-md bg-blue-500 cursor-pointer" type="submit" value="Login">
        </form>
    </div>
</body> 
</html>
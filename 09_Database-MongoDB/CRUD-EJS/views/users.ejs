<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="h-full w-full bg-zinc-900 text-white p-10">
        <a class="text-blue-500" href="/">Back To Home</a>
        <h1 class="text-3xl tracking-tighter mt-10">All Users</h1>
        <div class="users flex gap-3 flex-wrap">
            <% if(users.length > 0){ %>
                <% users.forEach(function(user){ %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-52 rounded-lg bg-zinc-700 overflow-hidden"> 
                        <img class="w-full h-full object-cover object-top" src="<%= user.image %>" alt="">
                    </div> <!--For Image-->
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>
                    <div class="flex gap-3 mt-10">
                        <a class="text-zinc-200" href="/edit/<%= user._id %>">Edit User</a>
                        <a class="text-red-500" href="/delete/<%= user._id %>">Delete user</a>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <h1 class="text-3xl tracking-tighter mt-10">No Users Found</h1>
            <% } %>            
        </div>
    </div>
</body>
</html>